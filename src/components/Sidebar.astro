---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import avatar from '../assets/illustrations/avatar.jpg';
---
<aside class="flex flex-col gap-6">
  <div class="h-40 w-40 overflow-hidden rounded-full border border-line">
    <Image
      src={avatar}
      alt={site.avatar.alt}
      loading="eager"
      widths={[160, 320]}
      sizes="160px"
      class="h-full w-full object-cover object-center"
    />
  </div>
  <div>
    <h1 class="text-4xl font-bold tracking-tight">{site.name}</h1>
    {site.titles.map((title) => (
      <p class="text-base text-muted">{title}</p>
    ))}
  </div>
  <div class="pt-8">
    <SocialLinks />
  </div>
</aside>
