---
interface Props {
  skills: readonly string[];
}
const { skills } = Astro.props;
---
<div class="inline-flex max-w-full items-start gap-2 rounded-3xl border border-line bg-paper px-4 py-2 text-sm text-muted">
  <span aria-hidden="true">✧</span>
  <p class="text-balance">{skills.join(' · ')}</p>
</div>
