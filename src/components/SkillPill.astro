---
interface Props {
  skills: readonly string[];
}
const { skills } = Astro.props;
---
{/* Mobile: chips that wrap — a single middot pill reads poorly on narrow screens */}
<ul class="flex flex-wrap justify-center gap-2 sm:hidden">
  {
    skills.map((skill) => (
      <li class="rounded-full border border-line px-3 py-1 text-sm text-muted">{skill}</li>
    ))
  }
</ul>

{/* Desktop: editorial pill from the mockup */}
<div class="hidden max-w-full items-center gap-2 rounded-full border border-line bg-paper px-4 py-2 text-sm text-muted sm:inline-flex">
  <span aria-hidden="true">✧</span>
  <p>{skills.join(' · ')}</p>
</div>
